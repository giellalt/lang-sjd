!! # Kildin Saami noun inflection

LEXICON IA-uu_ue_uu-XX 
!!кӯлль - куэлла - кӯле /kuuʹll - kuella - kuuʹle/
+N: IA-uu_ue_uu-XX_INFLECTION ;

LEXICON IA-uu_ue_uu-XX_INFLECTION
+Sg+Nom: SgNomSuf         ;
+Sg+Gen: SgGenAccPlNomSuf ;
+Sg+Acc: SgGenAccPlNomSuf ;
+Sg+Ill: SgIllSufA        ;
+Sg+Loc: SgLocSuf         ;
+Sg+Com: SgComPlLocSuf    ;
+Sg+Abe: SgAbeSuf         ;
+Sg+Ess: SgEssSuf         ;
+Sg+Par: SgParSuf         ;

+Pl+Nom: SgGenAccPlNomSuf ;
+Pl+Gen: PlGenSuf         ;
+Pl+Acc: PlAccIllSuf      ;
+Pl+Ill: PlAccIllSuf      ;
+Pl+Loc: SgComPlLocSuf    ;
+Pl+Com: PlComSuf         ;
+Pl+Abe: PlAbeSuf         ;

LEXICON 4DА  !!= @CODE@
+N: 4DA_INFLECTION ;

LEXICON 4DA_INFLECTION
+Sg+Nom:%^WG         K_SG_NOM ; 
+Sg+Gen:%^DI%>э      K_SG_GEN ;
+Sg+Acc:%^WG         K_SG_ACC ;
+Sg+Ess:%>энҍ        K_SG_ESS ;
+Sg+Loc:%^WG%>эсьт   K_SG_LOC ;
+Sg+Ill:%^DI%>а      K_SG_ILL ; 
+Sg+Abe:%^WG%>ха     K_SG_ABE ;
+Sg+Com:%^WG%>энҍ    K_SG_COM ;

+Pl+Nom:%^WG         K_PL_NOM ;
+Pl+Acc:%^WG%>этҍ    K_PL_ACC ;
+Pl+Loc:%^WG%>энҍ    K_PL_LOC ;
+Pl+Abe:%^WG%>эха    K_PL_ABE ;
+Pl+Com:%^WG%>эгуэйм K_PL_COM ;

LEXICON N2-CLU-JE
+N: N2-CLU-JE_INFLECTION ;

LEXICON N2-CLU-JE_INFLECTION
+Sg+Nom:%>0 K_SG_NOM ;
+Sg+Ill:%^CLDPAL%>а K_SG_ILL ;
+Pl+Nom:%^WG%>0 K_PL_NOM ;

LEXICON N2-AFF
+N: N2-AFF_INFLECTION ;

LEXICON N2-AFF_INFLECTION
+Sg+Nom:%>0 K_SG_NOM ;
+Sg+Ill:%>а K_SG_ILL ;
+Pl+Nom:%^WG%>0 K_PL_NOM ;

LEXICON KOOREB
+N: KOOREB_INFLECTION ;

LEXICON KOOREB_INFLECTION
+Sg+Nom:%>0 K_SG_NOM ;
+Sg+Ill:%^EPHV%>а K_SG_ILL ;
+Sg+Loc:%^EPHV%>эсьт K_SG_LOC ;

LEXICON KNIIGA
+N: KNIIGA_INFLECTION ;

LEXICON KNIIGA_INFLECTION
+Sg+Nom: K_SG_NOM ;
+Sg+Gen: K_SG_GEN ;
+Sg+Acc: K_SG_ACC ;
+Pl+Nom: K_PL_NOM ;
+Pl+Gen: K_PL_GEN ;
+Pl+Acc:%>тҍ K_PL_ACC ;

LEXICON SYJJT
+N: SYJJT_INFLECTION ;

LEXICON SYJJT_INFLECTION
+Sg+Nom: K_SG_NOM ;
+Sg+Gen:%^WG K_SG_GEN ;
+Sg+Acc:%^WG K_SG_ACC ;
+Sg+Ill:%>а K_SG_ILL ;
+Pl+Nom:%^WG K_PL_NOM ;
+Pl+Loc:%^WG%>энҍ K_PL_LOC ;

LEXICON PIIŊŊK !Ill depal, -e
+N:     SgNomSuf    ;
+N:%^WG SgGenAccSuf ;
+N:  	SgIllSufE   ; 
+N:%^WG SgLocSuf    ;
+N:%^WG SgAbeSuf    ;
+N:%^WG SgComSuf    ;
+N:     SgEssSuf      ;
+N:     ParSufE     ;
+N:%^WG PlNomSuf    ;
+N:%^WG PlGenSuf    ;
+N:%^WG PlAccSuf    ;
+N:%^WG PlIllSuf    ;
+N:%^WG PlLocSuf    ;
+N:%^WG PlAbeSuf    ;
+N:%^WG PlComSuf    ;


!! "class1" = monosyllabic/non-palatalized inflection foot, str-wk, no ablaut/umlaut, palatalization in Ill.Sg
LEXICON 1DA !!= @CODE@ is orthographic subclass with xx--> x

  +N:     SgNomSuf    ;
  +N:%^WG SgGenAccSuf ;
 +N:  SgIllSufA  ; 
  +N:%^WG SgLocSuf    ;
  +N:%^WG SgAbeSuf    ;
  +N:%^WG SgComSuf    ;
  +N:     SgEssSuf      ;
  +N:     ParSufE      ;

  +N:%^WG PlNomSuf    ;
  +N:%^WG PlGenSuf    ;
  +N:%^WG PlAccSuf    ;
  +N:%^WG PlIllSuf    ;
  +N:%^WG PlLocSuf    ;
  +N:%^WG PlAbeSuf    ;
  +N:%^WG PlComSuf    ;

LEXICON 1DB !!= @CODE@ is orthographic subclass with xy-->x and "half-palatalization" in Ill.Sg;
!! OBS! SgIllSufJE vs. SgIllSufHalfE does not mark a true morphological subclass, but is due to orthographic conventions

 +N:     SgNomSuf      ;
 +N:%^WG SgGenAccSuf   ;
!+N:%^DI   SgIllSufHalfE ; %^DI? is a "placeholder"? I have to check why we needed this in the earlier version
 +N:     SgIllSufHalfE ;
 +N:%^WG SgLocSuf      ;
 +N:%^WG SgAbeSuf      ;
 +N:%^WG SgComSuf      ;
 +N:     SgEssSuf        ;
 +N:     ParSufE        ;

 +N:%^WG PlNomSuf      ;
 +N:%^WG PlGenSuf      ;
 +N:%^WG PlAccSuf      ;
 +N:%^WG PlIllSuf      ;
 +N:%^WG PlLocSuf      ;
 +N:%^WG PlAbeSuf      ;
 +N:%^WG PlComSuf      ;

!! Lexica 2D etc are classes from Kuruch dictionary.
!! It is unclear whether this is the correct classification

LEXICON 2D !!= @CODE@ like 1D ?  these are just dummy for the moment
 +N:     SgNomSuf    ; ! Им.
 +N:%^WG SgGenAccSuf ; ! Род., Вин.
 +N:%^DI SgIllSufJE  ; ! Дат.-напр
 +N:%^WG SgLocSuf    ; ! Местн.
 +N:%^WG SgAbeSuf    ; ! Лишит.
 +N:%^WG SgComSuf    ; ! Совм.
 +N:     SgEssSuf      ; ! Превр.
 +N:     ParSufE      ; ! Парт.

 +N:%^WG PlNomSuf    ; ! Им.
 +N:%^WG PlGenSuf    ; ! Вин.
 +N:%^WG PlAccSuf    ; ! Вин.
 +N:%^WG PlIllSuf    ; ! Местн.
 +N:%^WG PlLocSuf    ; ! Местн.
 +N:%^WG PlAbeSuf    ; ! Лишит.
 +N:%^WG PlComSuf    ; ! Совм.

LEXICON 3D !!= @CODE@
 +N:     SgNomSuf    ; ! Им.
 +N:%^WG SgGenAccSuf ; ! Род., Вин.
 +N:%^DI SgIllSufJE  ; ! Дат.-напр
 +N:%^WG SgLocSuf    ; ! Местн.
 +N:%^WG SgAbeSuf    ; ! Лишит.
 +N:%^WG SgComSuf    ; ! Совм.
 +N:     SgEssSuf      ; ! Превр.
 +N:     ParSufE      ; ! Парт.

 +N:%^WG PlNomSuf    ; ! Им.
 +N:%^WG PlGenSuf    ; ! Вин.
 +N:%^WG PlAccSuf    ; ! Вин.
 +N:%^WG PlIllSuf    ; ! Местн.
 +N:%^WG PlLocSuf    ; ! Местн.
 +N:%^WG PlAbeSuf    ; ! Лишит.
 +N:%^WG PlComSuf    ; ! Совм.

LEXICON 4D  !!= @CODE@ is contract
     +N:%^WG     SgNomSuf    ; ! Им.
     +N:%^MON	 SgGenAccPlNomGenSuf ; ! Род.
     +N:%^MON	 SgEssSuf      ; ! Превр.
     +N:%^MON	 SgLocSuf    ; ! Местн.
     +N:%^MON%>ъ SgIllSufJE  ; !hard sign insertion needs a twolc-rule
     +N:%^MON     SgAbeSufAHTA    ; ! Лишит.
     +N:%^MON     SgComSuf    ; ! Совм.
	 +N:%^MON%>ъ ParSufJEDDJE ; !hard sign insertion needs a twolc-rule
     +N:%^MON     PlAccSuf    ; ! Вин.
     +N:%^MON     PlLocSuf    ; ! Местн.
     +N:%^MON     PlAbeSuf    ; ! Лишит.
     +N:%^MON     PlComSuf    ; ! Совм.

LEXICON 5D  !!= @CODE@ goes to 1DA
  1DA ;

LEXICON OAHPA_N  !!= @CODE@ is all the words from OAHPA_N, we just point them to 1DA.
  1DA ; ! Just pointing it on to the first and best
  
LEXICON ELAN_N  !!= @CODE@ is all the words from ELAN_N, we just point them to 1DA.
  1DA ; ! Just pointing it on to the first and best


!! ## Case affixes

LEXICON SgNomSuf !!= @CODE@
:%>0     K_SG_NOM ;
 
LEXICON SgGenAccPlNomSuf !!= @CODE@
:%^WG%>0 K_SG_NOM ;

LEXICON SgIllSufA  !!= @CODE@
!:%^DPAL%>а K_SG_ILL ;
:%^DI%>а K_SG_ILL ;

LEXICON SgLocSuf  !!= @CODE@
:%^WG%>есьт K_SG_LOC ;

LEXICON SgComPlLocSuf !!= @CODE@
:%^WG%>енҍ K_SG_COM ;

LEXICON SgAbeSuf !!= @CODE@
:%^WG%>ха K_SG_ABE ;
 
LEXICON SgEssSuf !!= @CODE@
:%>енҍ K_SG_ESS ;

LEXICON SgParSuf  !!= @CODE@
:%>е K_SG_PAR ;

LEXICON PlGenSuf !!= @CODE@
:%^WG%>е K_PL_GEN ;

LEXICON PlAccIllSuf !!= @CODE@
:%^WG%>етҍ K_PL_ACC ;

LEXICON PlComSuf !!= @CODE@
:%^WG%>егуэйм K_PL_COM ;

LEXICON PlAbeSuf !!= @CODE@
:%^WG%>еха K_PL_ABE ;

!!-------

LEXICON SgGenAccPlNomGenSuf !!= @CODE@
+Pl+Nom:%>э K_PL_NOM ;
+Sg+Gen:%>э K_SG_GEN ;
+Sg+Acc:%>э K_SG_ACC ;
+Pl+Gen:%>э K_PL_GEN ; 

LEXICON ParSufE  !!= @CODE@
 +Sg+Par:%>э K_SG_PAR ;

LEXICON ParSufHalfE  !!= @CODE@
 +Sg+Par:%>ӭ K_SG_PAR ; !they are allomorphs only in orthography and should be modelled in TWOLC instead
 
LEXICON ParSufJEDDJE
+Sg+Par:%>едтӭ K_SG_PAR ;

LEXICON SgIllSufE !!= @CODE@
 +Sg+Ill:%>э K_SG_ILL ;

LEXICON SgIllSufJE !!= @CODE@
 +Sg+Ill:%>е K_SG_ILL ;

LEXICON SgIllSufHalfE !!= @CODE@
 +Sg+Ill:%>ӭ K_SG_ILL ;

LEXICON SgAbeSufAHTA
+Sg+Abe:%>аһта K_SG_ABE ;
